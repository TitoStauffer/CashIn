# Copy to deploy/observability/.env on the VPS (never commit the copy). See
# docs/knowledge/runbooks/observability-vps.md.

# Grafana administrator login. Required, with no default; do not use "admin".
GRAFANA_ADMIN_USER=

# Path, on the host, of a file that holds only the administrator password (chmod 600, outside the repository).
GRAFANA_ADMIN_PASSWORD_FILE=/etc/saldocerto/observability/grafana-admin-password
