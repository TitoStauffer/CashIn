# Copy to deploy/production/.env on the VPS (never commit the copy) and fill in every value.
# docs/knowledge/runbooks/production-vps.md explains each step.

# Public name of the service; Caddy obtains its certificate. Example: app.example.com
SITE_ADDRESS=
# Contact for the certificate authority (expiry notices).
ACME_EMAIL=

# Database. Generate the password with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_DB=saldocerto
POSTGRES_USER=saldocerto
POSTGRES_PASSWORD=

# Outgoing email for confirmation, invitation and access links (required in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
