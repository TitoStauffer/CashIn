{
  "name": "@saldocerto/github-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Publishes pull request reports and formal reviews as the CashIn GitHub App.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "review": "node src/cli.mjs",
    "publish-report": "npm run build && node dist/report-cli.js",
    "readiness": "npm run build && node dist/readiness-cli.js",
    "workflow-readiness": "npm run build && node dist/workflow-readiness-cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
