# Conta Jira usada pela integração (a mesma conta do usuário, conforme o AGENTS.md).
# Crie o token em https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=

# Used only by the post-merge workflow/CLI. GitHub Actions sets GITHUB_TOKEN automatically.
JIRA_BASE_URL=https://your-site.atlassian.net
GITHUB_APP_BOT_LOGIN=cashin-devagents[bot]
GITHUB_TOKEN=
