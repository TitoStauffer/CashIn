POSTGRES_DB=saldocerto
POSTGRES_USER=saldocerto
POSTGRES_PASSWORD=saldo_dev_only

WEB_BASE_URL=http://localhost:5173

# Observabilidade local (docs/observability.md). Valor vazio no endpoint desliga a telemetria;
# OTEL_LOGS_EXPORTER=none mantém os logs só na saída padrão; OTEL_METRICS_EXPORTER=none desliga as métricas.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://observability:4318
# OTEL_LOGS_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp

# Use a Google App Password, not your Google Account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Link de solicitação de acesso a carteira compartilhada (horas; padrão: 168).
WALLET_ACCESS_LINK_TTL_HOURS=168

