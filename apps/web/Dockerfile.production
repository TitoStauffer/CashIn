# Production image of the Web (DEV-159): the static build served by Caddy, which also terminates HTTPS and
# forwards /api to the API (deploy/production/Caddyfile, mounted at run time). The development image
# (Dockerfile) runs the Vite dev server. Base images are pinned by digest (deploy/production/check-compose.mjs).
FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# Caddy 2.11.9.
FROM caddy:2-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
COPY --from=build /app/dist /srv
