{
  "expo": {
    "name": "Saldo Certo",
    "slug": "saldo-certo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "saldocerto",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
